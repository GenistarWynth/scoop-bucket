    "notes": "Steam updates its own client and game library; this manifest only handles the initial install.",
    "architecture": {
        "64bit": {
            "url": "https://cdn.akamai.steamstatic.com/client/installer/SteamSetup.exe",
            "hash": "7d3654531c32d941b8cae81c4137fc542172bfa9635f169cb392f245a0a12bcb"
        }
    },
    "installer": {
        "script": "Start-Process \"$dir\\SteamSetup.exe\" -ArgumentList '/S' -Wait"
    },
    "uninstaller": {
        "script": "Start-Process \"${env:ProgramFiles(x86)}\\Steam\\uninstall.exe\" -ArgumentList '/S' -Wait -ErrorAction SilentlyContinue"
    }
}
