{
    "version": "1.19.0",
    "description": "Bettbox - Mihomo (Clash) GUI client",
    "homepage": "https://github.com/appshubcc/Bettbox",
    "license": "GPL-3.0",
    "url": "https://github.com/appshubcc/Bettbox/releases/download/v1.19.0/Bettbox-1.19.0-windows-amd64-setup.exe",
    "hash": "d32ded2a65ecb359d8f21e4af386ed35881f94a780fd541addfe08285ba32968",
    "innosetup": true,
    "bin": "bettbox.exe",
    "shortcuts": [
        [
            "bettbox.exe",
            "Bettbox"
        ]
    ],
    "pre_uninstall": [
        "# Bettbox 是本机的代理出口，而 scoop 下载又依赖它 —— 更新它会形成循环依赖。",
        "# scoop 更新的顺序是: 下载 -> 校验哈希 -> pre_uninstall -> uninstall -> install -> post_install",
        "# (libexec/scoop-update.ps1)，所以在这一步停掉它不影响本次下载，安装包已经在 cache 里了。",
        "# 前提: scoop config ignore_running_processes $true，否则 scoop 在下载之前就会中止。",
        "$svcName = 'BettboxHelperService'",
        "$procNames = @('Bettbox', 'BettboxCore')",
        "$stopped = $false",
        "Write-Host ''",
        "$svc = Get-Service -Name $svcName -ErrorAction SilentlyContinue",
        "if ($svc -and $svc.Status -ne 'Stopped') {",
        "    Stop-Service -Name $svcName -Force -ErrorAction SilentlyContinue",
        "    $svc.Refresh()",
        "    if ($svc.Status -eq 'Stopped') {",
        "        $stopped = $true",
        "        Write-Host \"  stopped service $svcName\" -ForegroundColor Green",
        "    } else {",
        "        Write-Host \"  无法停止 $svcName (通常是没有管理员权限)。更新仍会继续，因为 scoop 是装进新的版本目录、不覆盖旧文件；但服务会继续跑旧二进制，直到你重启它。\" -ForegroundColor Yellow",
        "    }",
        "}",
        "$running = @(Get-Process -Name $procNames -ErrorAction SilentlyContinue)",
        "if ($running) {",
        "    $names = ($running.ProcessName | Sort-Object -Unique) -join ', '",
        "    $running | Stop-Process -Force -ErrorAction SilentlyContinue",
        "    $running | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue",
        "    # 复查: 没真的杀干净就别置标记，否则装完会再拉一个实例变成双开",
        "    $still = @(Get-Process -Name $procNames -ErrorAction SilentlyContinue)",
        "    if ($still) {",
        "        Write-Host \"  $names 仍在运行，装完不会自动拉起，请手动确认。\" -ForegroundColor Yellow",
        "    } else {",
        "        $stopped = $true",
        "        Write-Host \"  stopped $names\" -ForegroundColor Green",
        "    }",
        "}",
        "# 传给 post_install: 只有真的停过，装完才拉回来 (全新安装不会自启)",
        "if ($stopped) { $env:BETTBOX_RESTART_AFTER_UPDATE = '1' }"
    ],
    "post_install": [
        "if ($env:BETTBOX_RESTART_AFTER_UPDATE -eq '1') {",
        "    Remove-Item Env:\\BETTBOX_RESTART_AFTER_UPDATE -ErrorAction SilentlyContinue",
        "    $svcName = 'BettboxHelperService'",
        "    $exe = \"$dir\\Bettbox.exe\"",
        "    Write-Host ''",
        "    if (Get-Service -Name $svcName -ErrorAction SilentlyContinue) {",
        "        Start-Service -Name $svcName -ErrorAction SilentlyContinue",
        "    }",
        "    if (Test-Path $exe) {",
        "        Start-Process -FilePath $exe",
        "        # 等代理核心起来，否则同一批 scoop update 里排在后面的 app 会撞上没网的窗口",
        "        for ($i = 0; $i -lt 30 -and -not (Get-Process -Name 'BettboxCore' -ErrorAction SilentlyContinue); $i++) {",
        "            Start-Sleep -Milliseconds 500",
        "        }",
        "        if (Get-Process -Name 'BettboxCore' -ErrorAction SilentlyContinue) {",
        "            Write-Host '  Bettbox 已重新拉起，代理核心就绪。' -ForegroundColor Green",
        "        } else {",
        "            Write-Host '  Bettbox 已拉起，但 15s 内没等到 BettboxCore，后面的 app 下载可能没代理。' -ForegroundColor Yellow",
        "        }",
        "    } else {",
        "        Write-Host \"  找不到 $exe，没能自动拉起 Bettbox。\" -ForegroundColor Yellow",
        "    }",
        "}"
    ],
    "checkver": {
        "github": "https://github.com/appshubcc/Bettbox"
    },
    "autoupdate": {
        "url": "https://github.com/appshubcc/Bettbox/releases/download/v$version/Bettbox-$version-windows-amd64-setup.exe"
    }
}
